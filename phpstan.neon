parameters:
    level: 6
    # Public methods check PHPDoc-typed input at runtime on purpose
    treatPhpDocTypesAsCertain: false
    paths:
        - src
    excludePaths:
        - tests
        - src/DependencyInjection/
        - src/GA4AnalyticsDataBundle.php
    ignoreErrors:
        -
            identifier: missingType.iterableValue
        -
            message: '#Unsafe usage of new static\(\)\.#'
            path: src/Domain/Period.php
